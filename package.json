{
  "name": "@riposta/pi-jev",
  "version": "0.1.1",
  "description": "A Jev classification layer for the Pi coding agent: typed routing, permission gating, context shielding, pruning and loop detection.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Adam Dąbrowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riposta/pi-jev.git"
  },
  "homepage": "https://github.com/riposta/pi-jev#readme",
  "bugs": {
    "url": "https://github.com/riposta/pi-jev/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "jev",
    "typesafe",
    "classification",
    "llm-routing"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./questions": "./src/questions.ts",
    "./config": "./src/config.ts"
  },
  "files": [
    "src",
    "tools",
    "fixtures",
    "examples",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:pi": "node test/pi/run-e2e.mjs",
    "test:pi:live": "node test/pi/run-live.mjs",
    "test:pi:live-model": "node test/pi/run-live-model.mjs",
    "test:all": "vitest run && node test/pi/run-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "calibrate": "node --experimental-strip-types tools/calibrate.ts",
    "labels": "node --experimental-strip-types tools/labels.ts",
    "score": "node --experimental-strip-types tools/score-labels.ts fixtures/gate-real.jsonl",
    "replay": "node --experimental-strip-types tools/replay.ts",
    "evaluate": "node --experimental-strip-types tools/evaluate.ts"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
